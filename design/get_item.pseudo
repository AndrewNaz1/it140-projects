# Project One Get-Item Pseudocode
#
# Graded checkpoint: Module Five Project One
#
# Game: Bramble Hollow Apiary
# Design reference: design/game_storyboard.md and design/game_map.drawio
# This module supports the movement module in design/move.pseudo: the
# player moves with "go <direction>" and picks things up with
# "get <item>".

# TODO 1: Identify the information the pickup process needs.
# Consider the player's current room, the item in that room, and the
# player's inventory.

SET current_room          # the room the player is standing in now
SET room_item             # the item sitting in the current room, if any
SET inventory             # the items the player has already collected
SET required_items        # every item the player must gather to win
SET command               # the full command the player typed
SET wanted_item           # the item name the player asked for

# Each room except the start room and the villain room holds exactly one
# item, and each item belongs to exactly one room.

ROOMS = {
    "room0": { "name": "Honey Gate",             "item": NONE },
    "room1": { "name": "Bottling Shed",          "item": "Foghorn Press" },
    "room2": { "name": "Wax Works",              "item": "Copper Smoker" },
    "room3": { "name": "Lavender Rows",          "item": "Wax Tablet" },
    "room4": { "name": "Willow Bend",            "item": "Riverman's Net" },
    "room5": { "name": "Honey Cellar",           "item": "Harvest Ledger" },
    "room6": { "name": "Clay Road",              "item": "Bone Key" },
    "room7": { "name": "Hollow Queen's Chamber", "item": NONE }
}

SET required_items = all six item names above
SET inventory = empty list
SET current_room = "room0"

# TODO 2: Prompt for and receive the player's pickup command.

OUTPUT "What do you want to do?"
INPUT command

# TODO 3: Validate whether the requested item can be picked up.
# Show the decision clearly.

SET room_item = ROOMS[current_room]["item"]

IF command starts with "get"
    SET wanted_item = the item name in command
ELSE
    SET wanted_item = ""        # not a pickup command at all
END IF

IF room_item = NONE
    pickup is NOTHING_HERE      # start room and villain room
ELSE IF wanted_item = ""
    pickup is NOT_A_PICKUP      # the player typed something else
ELSE IF wanted_item IS already in inventory
    pickup is ALREADY_HELD
ELSE IF wanted_item IS first required item in inventory order list
    pickup is CORRECT_ITEM
ELSE
    pickup is WRONG_ITEM        # it exists somewhere, but not here
END IF

# TODO 4: Describe what happens when the pickup is valid.
# Include the inventory update and the player output.

IF pickup is CORRECT_ITEM
    ADD room_item TO inventory
    SET ROOMS[current_room]["item"] = NONE
    OUTPUT "You pick up " + room_item + "."
    OUTPUT "You are carrying " + inventory.
    IF inventory contains every item in required_items
        OUTPUT "You are carrying everything the apiary needs."
        OUTPUT "The Clay Road leads north to the Old Orchard."
    END IF
END IF

# TODO 5: Describe what happens when the pickup is not valid.
# Include the output the player should receive.

IF pickup is NOTHING_HERE
    OUTPUT "There is nothing to pick up here."
    inventory does NOT change
END IF

IF pickup is NOT_A_PICKUP
    OUTPUT "That is not something you can get."
    OUTPUT "Try get <item name>."
    inventory does NOT change
END IF

IF pickup is ALREADY_HELD
    OUTPUT "You already have " + wanted_item + "."
    inventory does NOT change
END IF

IF pickup is WRONG_ITEM
    OUTPUT "There is no " + wanted_item + " in this room."
    IF room_item IS NOT NONE
        OUTPUT "You see " + room_item + " here."
    END IF
    inventory does NOT change
END IF

# TODO 6: Show how pickup fits into repeated gameplay.
# The game keeps accepting commands until a required ending occurs, so
# the player can walk the whole map, gather all six items, and only then
# reach the villain.

SET game_over = FALSE

WHILE game_over = FALSE
    OUTPUT "You are in " + ROOMS[current_room]["name"] + "."
    OUTPUT "What do you want to do?"
    INPUT command

    IF command starts with "get"
        RUN the pickup steps above from TODO 3
    ELSE IF command starts with "go"
        RUN the movement steps from design/move.pseudo
    ELSE
        OUTPUT "You can go somewhere or get an item."
    END IF

    IF current_room = "room7"
        RUN the villain encounter
        IF the player wins OR the player loses
            SET game_over = TRUE
        END IF
    END IF
END WHILE

OUTPUT "The game has ended."


